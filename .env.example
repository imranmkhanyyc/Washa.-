# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/washa
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/washa_test

# --- API ---
PORT=3001
PUBLIC_API_URL=https://api.example.com
LOG_LEVEL=info
# inline = in-process job runner (dev/tests), pgboss = pg-boss on DATABASE_URL (production)
JOB_QUEUE=pgboss

# --- WhatsApp Cloud API (Meta) ---
WA_GRAPH_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Staff numbers alerted on handoff / payment issues (comma-separated E.164)
STAFF_ALERT_PHONES=
GM_PHONE=

# --- Claude (understanding only) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- M-Pesa Daraja ---
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Till (Buy Goods): store number = head-office shortcode; till = PartyB
# Sandbox: use test shortcode 174379 for both and CustomerPayBillOnline
MPESA_STORE_NUMBER=174379
MPESA_TILL_NUMBER=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_SECRET=change-me-long-random-string
# Optional comma-separated IP allowlist for callbacks (empty = off)
MPESA_CALLBACK_IP_ALLOWLIST=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
